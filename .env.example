# MCP Server Configuration
# Base URL for MCP server (without /sse endpoint - that's added automatically)
# For local testing:
MCP_SERVER_URL=http://localhost:8080

# For ngrok/remote testing, use your ngrok URL (without /sse):
# MCP_SERVER_URL=https://your-ngrok-url.ngrok-free.app

# Google Cloud Configuration
# Get your API key from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Optional: Google Cloud Project ID
GOOGLE_PROJECT_ID=your_project_id

# Gemini Model Configuration
# Available models: gemini-3.8-flash, gemini-2.5-flash, etc.
GEMINI_MODEL=gemini-3.8-flash

# Host Agent Mode
# Options: basic, advanced, parallel
# - basic: Sequential execution (default)
# - advanced: Dynamic routing with conditional agent execution
# - parallel: Parallel execution with result synthesis
HOST_AGENT_MODE=basic
